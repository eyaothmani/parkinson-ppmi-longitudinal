# Copier en .env (jamais versionné). Aucune valeur réelle ici.
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db   # par défaut : params.yaml > tracking.uri (suivi local uniquement)
# PPMI_RAW_DIR=data/synthetic               # pour travailler sans les vraies données
# GROQ_API_KEY=...                          # assistant documentaire (rag) : sans clé, mode extractif
# API_KEY=...                               # API : si définie, chaque route (sauf /health et /app/) exige l'en-tête X-API-Key
# MODEL_URI=models/predictor.pkl            # API : modèle local au lieu du champion du registre MLflow
